  categoria = c("A", "B", "C"),
  N = c(120, 95, 80),
  pct_1 = c(0.30, 0.45, 0.25),
  pct_2 = c(0.50, 0.35, 0.60)
)
graficar_barras_agrupadas(
  data = df,
  var_categoria = "categoria",
  var_n = "N",
  cols_porcentaje = c("pct_1", "pct_2"),
  etiquetas_series = c(pct_1 = "Serie 1", pct_2 = "Serie 2"),
  titulo = "Ejemplo",
  subtitulo = "Barras agrupadas"
)

}
