\name{reporte_recodificar_items}
\alias{reporte_recodificar_items}
\title{Recodificar items categóricos a escala estandarizada 0-100}
\usage{
reporte_recodificar_items(
  data,
  instrumento = NULL,
  vars = NULL,
  excluir_vars = NULL,
  orden_por_lista = NULL,
  codigos_missing = character(0),
  codigos_no_aplica = character(0),
  prefijo = "r100_",
  reemplazar = FALSE
)
}
\arguments{
\item{data}{Objeto devuelto por \code{reporte_data()} (clase
\code{prosecnur_reporte_tbl}) o un \code{data.frame} con estructura equivalente.}

\item{instrumento}{Objeto devuelto por \code{reporte_instrumento()}. Si es
\code{NULL}, se toma desde \code{attr(data, "instrumento_reporte")}.}

\item{vars}{Variables a recodificar. Si es \code{NULL}, usa todas las
\code{select_one} del instrumento presentes en \code{data}.}

\item{excluir_vars}{Variables a excluir de la recodificación.}

\item{orden_por_lista}{Configuración de orden ascendente (de menor a mayor)
